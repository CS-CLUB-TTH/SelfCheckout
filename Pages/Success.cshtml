@page
@model SuccessModel
@{
    ViewData["Title"] = "Payment Success";
    Layout = "_KioskLayout";
}

<div class="success-screen">
    <div class="success-background-graphic">
        <img src="~/Secondary Graphic.svg" alt="" />
    </div>
    <div class="success-content">
        <div class="success-icon">
            <img src="~/check-icon.svg" alt="Success" style="width: 200px; height: 200px;" />
        </div>
        <h1 class="success-title">Payment Successful!</h1>
        <p class="success-message">Thank you for your purchase</p>
        
        @if (!string.IsNullOrEmpty(Model.TransactionId))
        {
            <div class="payment-details" style="margin-top: 30px; font-size: 18px; color: #666;">
                @if (Model.Amount > 0)
                {
                    <p><strong>Amount:</strong> AED @Model.Amount.ToString("0.00")</p>
                }
                @if (!string.IsNullOrEmpty(Model.AuthorizationCode))
                {
                    <p><strong>Auth Code:</strong> @Model.AuthorizationCode</p>
                }
                @if (!string.IsNullOrEmpty(Model.ReferenceNumber))
                {
                    <p><strong>Reference:</strong> @Model.ReferenceNumber</p>
                }
                @if (!string.IsNullOrEmpty(Model.CardType) && !string.IsNullOrEmpty(Model.CardLast4))
                {
                    <p><strong>Card:</strong> @Model.CardType **** @Model.CardLast4</p>
                }
                <p style="font-size: 14px; margin-top: 10px;"><strong>Transaction ID:</strong> @Model.TransactionId</p>
            </div>
        }
        
        <div id="printStatus" style="margin-top: 20px; font-size: 16px; color: #28a745;">
            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
            Printing receipt...
        </div>
        
        <p class="success-message" style="font-size: 22px; margin-top: 30px;">
            Redirecting to feedback...
        </p>
    </div>
</div>

@section Scripts {
    <!-- Zebra Printer Integration - Android Native Bridge -->
    <script src="~/js/zebra-printer.js"></script>
    
    <script>
        // Configuration constants
        const PRINT_STATUS_HIDE_DELAY = 3000; // ms to hide print status message
        const FEEDBACK_REDIRECT_DELAY = 5000; // ms before redirecting to feedback
        
        // Receipt ZPL data from server
        const receiptZpl = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ReceiptZpl ?? ""));
        
        // Auto-print receipt on page load via Android Native Bridge
        document.addEventListener('DOMContentLoaded', async function() {
            const printStatus = document.getElementById('printStatus');
            
            try {
                console.log('Starting automatic receipt printing via Android Native Bridge...');
                
                if (!receiptZpl) {
                    printStatus.innerHTML = '<i class="bi bi-info-circle"></i> Receipt data not available';
                    printStatus.style.color = '#6c757d';
                    console.warn('Receipt ZPL data missing');
                    return;
                }
                
                // Check if Android bridge is available
                if (!isPrintingAvailable()) {
                    printStatus.innerHTML = '<i class="bi bi-exclamation-circle"></i> Printer not connected';
                    printStatus.style.color = '#dc3545';
                    console.error('Android Native Bridge not available - ensure custom WebView app is deployed');
                    return;
                }
                
                // Print via Android Native Bridge
                const result = await autoPrintReceipt(receiptZpl);
                
                if (result.success) {
                    printStatus.innerHTML = '<i class="bi bi-check-circle"></i> Receipt printed successfully!';
                    printStatus.style.color = '#28a745';
                    console.log('Receipt printed successfully via Android Native Bridge');
                } else {
                    printStatus.innerHTML = '<i class="bi bi-exclamation-triangle"></i> Print failed: ' + (result.error || 'Unknown error');
                    printStatus.style.color = '#dc3545';
                    console.error('Print failed:', result.error);
                }
            } catch (error) {
                console.error('Error during auto-print:', error);
                printStatus.innerHTML = '<i class="bi bi-exclamation-circle"></i> Print error: ' + error.message;
                printStatus.style.color = '#dc3545';
            }
            
            // Hide print status after delay
            setTimeout(() => {
                if (printStatus) {
                    printStatus.style.display = 'none';
                }
            }, PRINT_STATUS_HIDE_DELAY);
        });
        
        // Redirect to feedback after delay
        setTimeout(() => {
            window.location.href = '/Feedback';
        }, FEEDBACK_REDIRECT_DELAY);
    </script>
}
